const bankAccount = {
    accountNumber: "1234567890",
    balance: 1000,
    owner: "Anna Nowak",
    transactions: [],
    deposit: function(amount){
        this.balance += amount;
        this.transactions.push({
            type: 'deposit',
            amount: amount,
            date: new Date()
        });
        console.log("Dodano " + amount + " zł do konta, aktualny balans: " + this.balance);
    },
    withdraw: function(amount){
        if (amount > this.balance){
            console.log("ERROR : Masz za małe saldo na koncie by wykonać tą operacje");
        }
        else{
        this.balance -= amount;
        this.transactions.push({
            type: 'withdraw',
            amount: amount,
            date: new Date()
        })};
        console.log("Usunięto " + amount + " zł z konta, aktualny balans: " + this.balance);
    },
    getBalance: function(){
        console.log("Aktualny balans: " + this.balance);
    },
    getTransactionHistory: function(){
        console.log("Historia transakcji:", this.transactions);
    },

};
bankAccount.deposit(500);
bankAccount.withdraw(200);
bankAccount.withdraw(2000);
bankAccount.getBalance();
bankAccount.getTransactionHistory();
