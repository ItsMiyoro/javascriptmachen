const student = {
    name: "John Goverment",
    age: 21,
    major: "Informatyk",
    introduce: function(){
        console.log("Cześć, mam na imię " + this.name+ ", mam "+ this.age+ " lat i studiuję "+ this.major +".");
    },
    grades: [4, 5, 3],
    getAverage: function(){
        let avg = 0;
        for (let i = 0; i < this.grades.length; i++) {
            avg += this.grades[i];
        }
        avg = avg / this.grades.length;
        console.log("Średnia ocen: " + avg);
    }
};

student.introduce();
student.getAverage();
delete student.age;
student.introduce();

