function Book(title, author, year) {
  this.title = title;
  this.author = author;
  this.year = year;

  this.getSummary = function() {
    console.log(this.title+" napisana przez "+this.author+"  w "+this.year);
  };
}
const book1 = new Book("Lalka", "Bolesław Prus", 1890);
const book2 = new Book("Pan Tadeusz", "Adam Mickiewicz", 1834);
book1.getSummary();
book2.getSummary();

