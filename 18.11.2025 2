function Product(name, price, category){
    this.name = name,
    this.price = price,
    this.category = category,
    this.inStock = true,
    this.displayInfo = function(){
        console.log(name + " z kategori " + category + " o cenie "+ price +"$");
    },
    this.applyDiscount = function(percentage){
        price=Math.round(price*(percentage/100)).toFixed(2);
        console.log("Nowa cena produktu " + name +" : "+ price +"$. Zmniejszono cene o " + percentage +"%");
    }
}
const product1 = new Product("Borat", 67.99,"Film",true);
const product2 = new Product("Sans Granie",420.69,"Sans Granie",false);
const product3 = new Product("OS X Server", 2100.99, "System Operacyjny");
product1.displayInfo();
product2.displayInfo();
product3.displayInfo();
product1.applyDiscount(75);
product1.displayInfo();

